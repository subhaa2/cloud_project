{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/newFlashcard",
        "destination": "/flashcards/new_flashcard.html"
      },
      {
        "source": "/flashcardLearn",
        "destination": "/flashcards/flashcard_learn.html"
      },
      {
        "source": "/flashcardCompetition",
        "destination": "/flashcards/flashcard_competition.html"
      }
    ]
  }
}